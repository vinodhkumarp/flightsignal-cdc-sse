{
  "name": "flight-signal",
  "version": "0.1.0",
  "description": "Real-time flight disruption and passenger-care reference architecture",
  "license": "MIT",
  "private": true,
  "type": "module",
  "workspaces": [
    "web"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"make dev-api\" \"npm run dev -w web\"",
    "dev:server": "make dev-api",
    "dev:web": "npm run dev -w web",
    "build": "npm run build -w web",
    "lint": "npm run lint -w web",
    "test": "npm run test -w web",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
