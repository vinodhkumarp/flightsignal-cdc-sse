# Copy to .env and adjust. Used by docker compose and the Makefile.
# These defaults are for local development only - never reuse them elsewhere.

POSTGRES_DB=flights
POSTGRES_USER=flights
POSTGRES_PASSWORD=flights
POSTGRES_PORT=5433

API_PORT=3101
WEB_PORT=8080
# Spring profiles for the containerised API:
#   prod = JSON logs; dev = demo seed data + development token issuer.
API_PROFILES=prod,dev
EVENT_RETENTION=30d

# Authentication
# dev: the UI's development sign-in gets HS256 tokens from the API (demo only).
DEV_TOKEN_SECRET=flightsignal-local-development-secret-change-me
# SSO: remove "dev" from API_PROFILES, set the issuer on the api service
# (SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI, optionally ..._AUDIENCES),
# and build the web image with VITE_AUTH_MODE=sso.
VITE_AUTH_MODE=dev
# Claim holding the user's stations, e.g. "stations" or "ext.stations".
STATIONS_CLAIM=stations

# Show the hidden Flight operations page in the web image.
VITE_SHOW_FLIGHT_OPERATIONS=false

# Continuous simulator (make simulate / --profile sim)
SIM_STEP_SECONDS=3
SIM_PAUSE_SECONDS=2
SIM_PASSENGERS=24
